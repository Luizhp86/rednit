{
  "buildCommand": "prisma generate && next build",
  "framework": "nextjs",
  "regions": ["gru1"],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/webhooks/stripe",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://stripe.com"
        }
      ]
    }
  ]
}
