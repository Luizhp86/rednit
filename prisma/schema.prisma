// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

enum AnalysisStage {
  FIRST_CHAT
  TALKING
  POST_DATE
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String?
  plan              Plan      @default(FREE)
  creditsFreeDaily  Int       @default(1)
  creditsPaid       Int       @default(0)
  proUntil          DateTime?
  lastDailyReset    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  analyses  Analysis[]
  payments  Payment[]
  entitlements Entitlement?

  @@map("users")
}

model Analysis {
  id         String         @id @default(uuid())
  userId     String
  stage      AnalysisStage
  inputJson  Json
  resultJson Json
  isPaid     Boolean        @default(false)
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("analyses")
}

model Payment {
  id          String   @id @default(uuid())
  userId      String
  provider    String   @default("asaas")
  externalId  String
  status      String   // PENDING, CONFIRMED, CANCELED, REFUNDED
  amountCents Int
  currency    String   @default("BRL")
  type        String   // ONE_TIME, SUBSCRIPTION
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([externalId])
  @@index([status])
  @@map("payments")
}

model Entitlement {
  id            String   @id @default(uuid())
  userId        String   @unique
  proUntil      DateTime?
  lastDailyReset DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}
