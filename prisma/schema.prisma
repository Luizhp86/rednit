generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                    String       @id @default(uuid())
  email                                 String       @unique
  name                                  String?
  plan                                  Plan         @default(FREE)
  creditsFreeDaily                      Int          @default(1)
  creditsPaid                           Int          @default(0)
  proUntil                              DateTime?
  lastDailyReset                        DateTime?
  createdAt                             DateTime     @default(now())
  updatedAt                             DateTime     @updatedAt
  facebook                              String?
  hasSeenOnboarding                     Boolean      @default(false)
  hasSeenPostFirstAnalysisOnboarding    Boolean      @default(false)
  instagram                             String?
  phone                                 String?
  signo                                 String?
  stripeCustomerId                      String?      @unique
  analyses                              Analysis[]
  entitlements                          Entitlement?
  leads                                 Lead[]
  payments                              Payment[]

  @@map("users")
}

model Analysis {
  id                    String        @id @default(uuid())
  userId                String
  stage                 AnalysisStage
  inputJson             Json
  resultJson            Json
  isPaid                Boolean       @default(false)
  createdAt             DateTime      @default(now())
  usedInRouteCorrection Boolean       @default(false)
  themeId               String?
  theme                 FormTheme?    @relation(fields: [themeId], references: [id])
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads                 Lead[]

  @@index([userId])
  @@index([createdAt])
  @@index([usedInRouteCorrection])
  @@index([themeId])
  @@map("analyses")
}

model Payment {
  id                 String              @id @default(uuid())
  userId             String
  provider           String              @default("asaas")
  externalId         String
  status             String
  amountCents        Int
  currency           String              @default("BRL")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  creditPackage      CreditPackage?
  creditsGranted     Int?
  subscriptionPeriod SubscriptionPeriod?
  type               PaymentType
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([externalId])
  @@index([status])
  @@index([type])
  @@map("payments")
}

model Entitlement {
  id             String    @id @default(uuid())
  userId         String    @unique
  proUntil       DateTime?
  lastDailyReset DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

model SystemConfig {
  id                           String    @id @default("default")
  minAnalysesFirstTime         Int       @default(3)
  minNewAnalysesForUnlock      Int       @default(4)
  freeCreditsDaily             Int       @default(10)
  geminiDailyLimit             Int       @default(100)
  geminiMonthlyBudgetCents     Int       @default(50000)
  geminiCallsToday             Int       @default(0)
  geminiLastResetDate          DateTime?
  proPriceMonthly              Int       @default(2990)
  proPriceYearly               Int       @default(29900)
  maintenanceMode              Boolean   @default(false)
  allowNewRegistrations        Boolean   @default(true)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  creditPricePack3             Int       @default(2490)
  creditPricePack5             Int       @default(3990)
  creditPriceSingle            Int       @default(799)
  proPriceQuarterly            Int       @default(7990)
  enableLeadAnalysis           Boolean   @default(true)
  enableLeadCta                Boolean   @default(true)
  enableLeadSignup             Boolean   @default(true)
  geminiModelAnalysis          String    @default("gemini-1.5-flash")
  geminiModelRouteCorrection   String    @default("gemini-2.0-flash")
  leadAnalysisPlans            String    @default("[\"INTERMEDIATE\",\"PRO\"]")
  leadCooldownHours            Int       @default(24)
  leadCtaPlans                 String    @default("[\"PRO\"]")
  leadMaxAnalysesPerDay        Int       @default(50)
  leadMaxAnalysisPerDay        Int       @default(10)
  leadMaxCtaPerDay             Int       @default(5)
  leadMaxRouteCorrectionPerDay Int       @default(3)
  leadMaxSignupPerDay          Int       @default(20)
  leadSignupPlans              String    @default("[\"BASIC\",\"INTERMEDIATE\",\"PRO\"]")
  therapistLeadsPerDay         Int       @default(10)
  therapistPriceBasic          Int       @default(7900)
  therapistPriceIntermediate   Int       @default(14900)
  therapistPricePro            Int       @default(24900)

  @@map("system_config")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@map("admins")
}

model GeminiUsageLog {
  id            String   @id @default(uuid())
  userId        String?
  endpoint      String
  tokensInput   Int      @default(0)
  tokensOutput  Int      @default(0)
  estimatedCost Int      @default(0)
  success       Boolean  @default(true)
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([endpoint])
  @@map("gemini_usage_logs")
}

model AdminLog {
  id         String   @id @default(uuid())
  adminEmail String
  action     String
  entity     String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminEmail])
  @@index([action])
  @@map("admin_logs")
}

model UserActivityLog {
  id          String          @id @default(uuid())
  userId      String?
  sessionId   String
  eventType   String
  eventData   Json?
  page        String?
  duration    Int?
  createdAt   DateTime        @default(now())
  ipAddress   String?
  journeyType UserJourneyType
  referrer    String?
  therapistId String?
  userAgent   String?

  @@index([createdAt])
  @@index([journeyType])
  @@index([userId])
  @@index([therapistId])
  @@index([sessionId])
  @@index([eventType])
  @@map("user_activity_logs")
}

model Therapist {
  id                 String          @id @default(uuid())
  email              String          @unique
  password           String?
  googleId           String?         @unique
  name               String
  type               TherapistType   @default(OUTRO)
  plan               TherapistPlan   @default(BASIC)
  crp                String?
  whatsapp           String?
  bio                String?
  photoUrl           String?
  instagram          String?
  website            String?
  specialties        String[]        @default(["relacionamentos"])
  status             TherapistStatus @default(PENDING)
  active             Boolean         @default(false)
  profileCompleted   Boolean         @default(false)
  stripeCustomerId   String?         @unique
  subscriptionId     String?
  subscriptionStatus String          @default("inactive")
  leadsReceived      Int             @default(0)
  leadsThisMonth     Int             @default(0)
  leadsSignup        Int             @default(0)
  leadsAnalysis      Int             @default(0)
  leadsCta           Int             @default(0)
  lastLeadAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  approvedAt         DateTime?
  approvedBy         String?
  leads              Lead[]

  @@index([status])
  @@index([plan])
  @@index([active])
  @@index([lastLeadAt])
  @@map("therapists")
}

model Demo {
  id          String     @id @default(uuid())
  name        String
  email       String
  phone       String
  company     String?
  scheduledAt DateTime
  status      DemoStatus @default(PENDING)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  @@index([scheduledAt])
  @@index([status])
  @@index([email])
  @@map("demos")
}

model Lead {
  id               String     @id @default(uuid())
  type             LeadType   @default(SIGNUP)
  status           LeadStatus @default(NEW)
  userId           String?
  userName         String?
  userEmail        String
  userPhone        String
  analysisId       String?
  matchName        String?
  analysisData     Json?
  therapistId      String?
  emailSentAt      DateTime?
  whatsappOpenedAt DateTime?
  createdAt        DateTime   @default(now())
  contactedAt      DateTime?
  convertedAt      DateTime?
  analysis         Analysis?  @relation(fields: [analysisId], references: [id])
  therapist        Therapist? @relation(fields: [therapistId], references: [id])
  user             User?      @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([status])
  @@index([therapistId])
  @@index([userId])
  @@index([createdAt])
  @@map("leads")
}

model FormTheme {
  id          String         @id @default(uuid())
  name        String         @unique
  displayName String
  description String?
  icon        String?
  color       String         @default("purple")
  active      Boolean        @default(true)
  order       Int            @default(0)
  seasonal    Boolean        @default(false)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  analyses    Analysis[]
  questions   FormQuestion[]

  @@index([active])
  @@index([order])
  @@index([seasonal])
  @@map("form_themes")
}

model FormQuestion {
  id            String                 @id @default(uuid())
  themeId       String?
  key           String
  label         String
  description   String?
  type          QuestionType
  required      Boolean                @default(false)
  order         Int
  weight        Int                    @default(50)
  placeholder   String?
  rows          Int?
  autoAdvance   Boolean                @default(false)
  showIf        Json?
  isFixed       Boolean                @default(false)
  fixedPosition FixedQuestionPosition?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  options       FormQuestionOption[]
  theme         FormTheme?             @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, key])
  @@index([themeId, order])
  @@index([isFixed])
  @@map("form_questions")
}

model FormQuestionOption {
  id         String       @id @default(uuid())
  questionId String
  value      String
  label      String
  hint       String?
  icon       String?
  color      String?
  order      Int          @default(0)
  createdAt  DateTime     @default(now())
  question   FormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, value])
  @@index([questionId, order])
  @@map("form_question_options")
}

enum Plan {
  FREE
  PRO
}

enum AnalysisStage {
  FIRST_CHAT
  TALKING
  POST_DATE
}

enum PaymentType {
  ONE_TIME
  SUBSCRIPTION
}

enum SubscriptionPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum CreditPackage {
  SINGLE
  PACK_3
  PACK_5
}

enum UserJourneyType {
  LEAD
  THERAPIST
  ADMIN
}

enum LeadJourneyEvent {
  LANDING_VIEW
  LOGIN_START
  LOGIN_SUCCESS
  SIGNUP_COMPLETE
  FORM_START
  FORM_STEP
  FORM_COMPLETE
  ANALYSIS_VIEW
  CTA_CLICK
  PHONE_SUBMIT
  WHATSAPP_OPEN
  DASHBOARD_VIEW
  ANALYSIS_HISTORY
  ROUTE_CORRECTION
  LOGOUT
  ACCOUNT_DELETE
}

enum TherapistJourneyEvent {
  LANDING_VIEW
  REGISTER_START
  REGISTER_COMPLETE
  LOGIN_SUCCESS
  PROFILE_UPDATE
  SUBSCRIPTION_START
  SUBSCRIPTION_ACTIVE
  DASHBOARD_VIEW
  LEAD_VIEW
  LEAD_CONTACT
  LEAD_CONVERT
  PLAN_UPGRADE
  PLAN_DOWNGRADE
  LOGOUT
}

enum TherapistType {
  TAROLOGO
  COACH
  HOLISTICO
  ASTROLOGO
  TERAPEUTA_FLORAL
  CONSTELADOR
  PSICOLOGO
  OUTRO
}

enum TherapistStatus {
  PENDING
  APPROVED
  SUSPENDED
  BLOCKED
}

enum TherapistPlan {
  BASIC
  INTERMEDIATE
  PRO
}

enum LeadType {
  SIGNUP
  ANALYSIS
  CTA
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum DemoStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QuestionType {
  CARD_SELECT
  TEXTAREA
  AVATAR_SELECT
  NUMBER
  MULTI_SELECT
}

enum FixedQuestionPosition {
  BEFORE
  AFTER
}
