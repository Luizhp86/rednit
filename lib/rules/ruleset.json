        "code": "FUTURO_NAO_FALA",
        "label": "Não fala sobre futuro",
        "deltas": {}
      },
      "FALA_NAO_FAZ": {
        "code": "FUTURO_FALA_NAO_FAZ",
        "label": "Fala mas não faz",
        "deltas": { "coerencia": -15, "risco_enrolacao": 15 }
