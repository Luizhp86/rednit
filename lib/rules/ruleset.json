      "SIM": {
        "code": "REMARCOU_SIM",
        "label": "Remarcou com data definida",
        "deltas": { "acao_mundo_real": 10 }
      },
      "NAO": {
        "code": "REMARCOU_NAO",
        "label": "Não remarcou",
        "deltas": { "acao_mundo_real": -15 },
        "red_flag": { "severity": "MEDIUM", "title": "Promessa sem ação" }
      },
      "NAO_SE_APLICA": {
        "code": "REMARCOU_NAO_SE_APLICA",
        "label": "Não se aplica",
        "deltas": {}
      }
    },
