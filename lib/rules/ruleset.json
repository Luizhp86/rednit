      "INSISTE": {
        "code": "RESPEITO_INSISTE",
        "label": "Insiste após você dizer não",
        "deltas": { "respeito": -25 },
        "red_flag": { "severity": "HIGH", "title": "Desrespeito a limites" }
      },
      "DEBOCHA": {
        "code": "RESPEITO_DEBOCHA",
        "label": "Debocha dos seus limites",
        "deltas": { "respeito": -35 },
        "red_flag": { "severity": "HIGH", "title": "Desrespeito grave a limites" }
      }
    },
    "fala_futuro": {
