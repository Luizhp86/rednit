    "POST_DATE": 1.3
  },
  "signals": {
    "iniciativa": {
      "VOCE_SEMPRE": {
        "code": "INICIATIVA_VOCE_SEMPRE",
        "label": "Você sempre inicia conversas",
        "deltas": { "reciprocidade": -20 }
      },
      "EQUILIBRADO": {
        "code": "INICIATIVA_EQUILIBRADO",
        "label": "Iniciativa equilibrada",
        "deltas": { "reciprocidade": 15 }
      },
      "MATCH_SEMPRE": {
        "code": "INICIATIVA_MATCH_SEMPRE",
        "label": "Match sempre inicia",
        "deltas": { "reciprocidade": 10 }
      }
    },
    "frequencia_contato": {
      "DIARIA": {
        "code": "FREQ_DIARIA",
        "label": "Frequência diária de contato",
        "deltas": { "constancia": 12 }
      },
      "ALTERNADA": {
        "code": "FREQ_ALTERNADA",
        "label": "Frequência alternada",
        "deltas": { "constancia": 6 }
      },
      "RARAMENTE": {
        "code": "FREQ_RARAMENTE",
        "label": "Frequência rara",
        "deltas": { "constancia": -12 }
      }
    },
    "tempo_resposta": {
      "MINUTOS": {
        "code": "RESP_MINUTOS",
        "label": "Responde em minutos",
        "deltas": { "constancia": 10 }
      },
      "HORAS": {
        "code": "RESP_HORAS",
        "label": "Responde em horas",
        "deltas": { "constancia": 4 }
      },
      "DIAS": {
        "code": "RESP_DIAS",
        "label": "Responde em dias",
        "deltas": { "constancia": -12, "risco_ghosting": 10 }
      }
    },
    "curiosidade_por_voce": {
      "ALTA": {
        "code": "CURIOSIDADE_ALTA",
        "label": "Alta curiosidade por você",
        "deltas": { "reciprocidade": 12, "coerencia": 8, "intencao": 8 }
      },
      "MEDIA": {
        "code": "CURIOSIDADE_MEDIA",
        "label": "Curiosidade moderada",
        "deltas": { "reciprocidade": 4, "coerencia": 2, "intencao": 2 }
      },
      "BAIXA": {
        "code": "CURIOSIDADE_BAIXA",
        "label": "Baixa curiosidade",
        "deltas": { "reciprocidade": -10, "coerencia": -6, "intencao": -6 }
      }
    },
    "respeito_limites": {
      "RESPEITA": {
        "code": "RESPEITO_TOTAL",
        "label": "Respeita totalmente seus limites",
        "deltas": { "respeito": 20 }
      },
      "NEGOCIA": {
        "code": "RESPEITO_NEGOCIA",
        "label": "Tenta negociar limites",
        "deltas": { "respeito": 5 }
