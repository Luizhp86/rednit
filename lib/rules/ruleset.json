      "SIM": {
        "code": "SO_MADRUGADA_SIM",
        "label": "Disponível só de madrugada",
        "deltas": { "disponibilidade": -12 }
      },
      "NAO": {
        "code": "SO_MADRUGADA_NAO",
        "label": "Disponível em horários normais",
        "deltas": {}
      }
    }
