        "deltas": { "acao_mundo_real": 12 }
      },
      "NAO": {
        "code": "ENCONTRO_MARCADO_NAO",
        "label": "Encontro não marcado",
        "deltas": {}
      }
    },
    "cancelou_encontro": {
      "SIM": {
        "code": "CANCELOU_SIM",
        "label": "Cancelou encontro",
        "deltas": { "acao_mundo_real": -10 }
      },
      "NAO": {
        "code": "CANCELOU_NAO",
        "label": "Nunca cancelou",
        "deltas": {}
      }
    },
