  "scores": {
    "reciprocidade": { "base": 50 },
    "constancia": { "base": 50 },
    "acao_mundo_real": { "base": 50 },
    "respeito": { "base": 50 },
    "coerencia": { "base": 50 },
    "disponibilidade": { "base": 50 },
    "risco_ghosting": { "base": 30 },
    "risco_enrolacao": { "base": 30 },
    "compat_objetivo": { "base": 50 }
  },
  "hypotheses": {
    "EXPLORANDO": {
      "signals": [
        { "field": "constancia", "score": 50, "operator": "<=", "weight": 20 },
        { "field": "acao_mundo_real", "score": 50, "operator": "<=", "weight": 20 },
        { "field": "fala_futuro", "value": "NAO_FALA", "weight": 15 },
        { "field": "estagio", "value": "TALKING", "weight": 10 },
        { "field": "estagio", "value": "POST_DATE", "weight": 15 }
      ],
      "threshold": 40
    },
    "BUSCA_FIXO": {
      "signals": [
        { "field": "constancia", "score": 70, "operator": ">=", "weight": 25 },
        { "field": "acao_mundo_real", "score": 70, "operator": ">=", "weight": 25 },
        { "field": "respeito", "score": 70, "operator": ">=", "weight": 20 },
        { "field": "curiosidade_por_voce", "value": "ALTA", "weight": 15 }
      ],
      "threshold": 50
    },
    "CARENCIA_VALIDACAO": {
      "signals": [
        { "field": "sinais_alerta", "contains": "LOVE_BOMBING", "weight": 30 },
        { "field": "sinais_alerta", "contains": "VITIMISMO", "weight": 20 },
        { "field": "iniciativa", "value": "VOCE_SEMPRE", "weight": 15 }
      ],
      "threshold": 40,
      "requires_text": true
    },
    "RECEM_SAIU_RELACAO": {
      "signals": [
        { "field": "sinais_alerta", "contains": "SUMICO_POS_INTIMIDADE", "weight": 35 },
        { "field": "ritmo_usuario", "value": "RAPIDO", "weight": 15 }
      ],
      "threshold": 45,
      "requires_text": true
    },
    "SEM_DISPONIBILIDADE_REAL": {
      "signals": [
        { "field": "disponivel_so_madrugada", "value": "SIM", "weight": 30 },
        { "field": "cancelou_encontro", "value": "SIM", "weight": 20 },
        { "field": "remarcou_com_data", "value": "NAO", "weight": 20 },
        { "field": "constancia", "score": 40, "operator": "<=", "weight": 15 },
        { "field": "acao_mundo_real", "score": 40, "operator": "<=", "weight": 15 }
      ],
      "threshold": 50
    }
  },
  "red_flags": [
    {
      "id": "DESRESPEITO_LIMITES",
      "title": "Desrespeito a limites",
      "severity": "HIGH",
      "triggers": [
        { "field": "respeito_limites", "value": "INSISTE", "required": true },
        { "field": "respeito_limites", "value": "DEBOCHA", "required": true }
      ],
      "impact": "Risco de relacionamento tóxico e falta de respeito"
    },
    {
      "id": "PROMESSA_SEM_ACAO",
      "title": "Promessa sem ação",
      "severity": "MEDIUM",
      "triggers": [
        { "field": "fala_futuro", "value": "FALA_NAO_FAZ", "required": true }
      ],
      "impact": "Alto risco de enrolação e frustração"
    },
    {
      "id": "CANCELOU_SEM_REMARCAR",
      "title": "Cancelou sem remarcar",
      "severity": "MEDIUM",
      "triggers": [
        { "field": "cancelou_encontro", "value": "SIM", "required": true },
        { "field": "remarcou_com_data", "value": "NAO", "required": true }
      ],
      "impact": "Falta de comprometimento e interesse real"
    },
    {
      "id": "BAIXA_DISPONIBILIDADE",
      "title": "Baixa disponibilidade real",
      "severity": "MEDIUM",
      "triggers": [
        { "field": "disponivel_so_madrugada", "value": "SIM", "required": true }
      ],
      "impact": "Incompatibilidade com relacionamento sério"
    },
    {
      "id": "INTERMITENCIA",
      "title": "Intermitência na comunicação",
      "severity": "MEDIUM",
      "triggers": [
        { "field": "frequencia_contato", "value": "RARAMENTE", "required": true },
        { "field": "tempo_resposta", "value": "DIAS", "required": false }
      ],
      "impact": "Falta de consistência e interesse"
    }
  ],
  "green_flags": [
    {
      "id": "CONSISTENCIA",
      "title": "Consistência",
      "severity": "MEDIUM",
      "triggers": [
        { "field": "frequencia_contato", "value": "DIARIA", "required": true },
        { "field": "tempo_resposta", "value": "DIAS", "operator": "!=", "required": false }
      ],
      "benefit": "Demonstra comprometimento e interesse genuíno"
    },
    {
      "id": "RECIPROCIDADE",
      "title": "Reciprocidade",
      "severity": "MEDIUM",
      "triggers": [
        { "field": "iniciativa", "value": "EQUILIBRADO", "required": true }
      ],
      "benefit": "Sinal positivo de interesse mútuo"
    },
    {
      "id": "RESPEITO",
      "title": "Respeito",
      "severity": "HIGH",
      "triggers": [
        { "field": "respeito_limites", "value": "RESPEITA", "required": true }
      ],
      "benefit": "Sinal de maturidade emocional e respeito"
    },
    {
      "id": "ACAO_CONCRETA",
      "title": "Ação concreta",
      "severity": "MEDIUM",
      "triggers": [
        { "field": "encontro_marcado", "value": "SIM", "required": true },
        { "field": "remarcou_com_data", "value": "SIM", "required": false }
      ],
      "benefit": "Demonstra intenção real e comprometimento"
    }
  ]
}
